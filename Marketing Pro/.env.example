# ============================================================
#  MARKETING PRO - Configurações de Ambiente
#  Copie este arquivo para .env e preencha com suas credenciais.
#  NUNCA faça commit do arquivo .env real!
#
#  Plataformas sem credenciais preenchidas usam dados de
#  demonstração automaticamente — o dashboard funciona sem
#  nenhuma chave configurada.
# ============================================================

# --- SERVIDOR ---
MARKETING_PRO_PORT=5050
FLASK_DEBUG=false

# --- META (Facebook + Instagram) ---
# Gerar em business.facebook.com > Configurações do negócio > Usuários do sistema
# Escopos necessários: leads_retrieval, ads_read, pages_read_engagement
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_SEU_ID_DE_CONTA
META_PAGE_ID=

# --- GOOGLE ADS ---
# https://developers.google.com/google-ads/api/docs/first-call/overview
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_ACCESS_TOKEN=

# --- LINKEDIN ADS ---
# LinkedIn Developer Portal > produto "Marketing Developer Platform"
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=urn:li:sponsoredAccount:SEU_ID

# --- TIKTOK ADS ---
# TikTok for Business Developer Portal
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
